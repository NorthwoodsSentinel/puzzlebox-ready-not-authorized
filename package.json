{
  "name": "puzzlebox-ready-not-authorized",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage && bun scripts/verify-gate-scope.ts",
    "test:fixture": "./run.sh",
    "local:gate": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run test:fixture"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "zod": "3.25.76"
  }
}
